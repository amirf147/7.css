{
  "version": "1.0.0",
  "fontSmoothing": {
    "textRendering": "optimizeLegibility",
    "mozOsxFontSmoothing": "grayscale",
    "webkitFontSmoothing": "antialiased"
  },
  "fontScale": {
    "windowTitle": {
      "px": 12,
      "pt": 9,
      "weight": 400,
      "lineHeight": "1.2",
      "halo": true
    },
    "body": {
      "color": "#000000",
      "px": 12,
      "pt": 9,
      "weight": 400,
      "lineHeight": "1.35"
    },
    "instructionHeader": {
      "color": "#003399",
      "px": 16,
      "pt": 12,
      "weight": 400,
      "lineHeight": "1.3"
    },
    "secondaryDescription": {
      "color": "#555555",
      "px": 11,
      "pt": 9,
      "weight": 400,
      "lineHeight": "1.3"
    },
    "caption": {
      "color": "#666666",
      "px": 10.5,
      "pt": 8,
      "weight": 400,
      "lineHeight": "1.2"
    }
  },
  "fontFamilies": {
    "code": "'Consolas', 'Lucida Console', 'Courier New', monospace",
    "primary": "'Segoe UI', 'Selawik', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif",
    "script": "'Segoe Print', 'Segoe Script', 'Comic Sans MS', cursive"
  }
}
